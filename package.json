{
  "name": "jtlt",
  "version": "0.12.0",
  "type": "module",
  "author": "Brett Zamir",
  "contributors": [],
  "license": "MIT",
  "types": "./dist/index.d.ts",
  "main": "src/index-node.js",
  "exports": {
    "types": "./dist/index.d.ts",
    "browser": {
      "import": "./src/index-browser.js"
    },
    "node": {
      "import": "./src/index-node.js"
    }
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "homepage": "https://github.com/s3u/JSONPath/",
  "repository": {
    "type": "git",
    "url": "https://github.com/brettz9/jtlt.git"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "fontoxpath": "^3.34.0",
    "jamilih": "0.69.0",
    "jhtml": "0.7.3",
    "jsdom": "30.0.1",
    "jsonpath-plus": "10.4.0",
    "prsc": "^4.0.0",
    "simple-get-json": "11.0.1",
    "whynot": "^5.0.0",
    "xpath2.js": "1.0.0-alpha-6",
    "xspattern": "^3.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@node-static/node-static": "^0.9.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/chai": "^5.2.3",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "baseline-browser-mapping": "^2.11.19",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "eslint": "^10.9.1",
    "eslint-config-ash-nazg": "^42.6.0",
    "mocha": "^11.8.0",
    "open": "^11.0.1",
    "rollup": "^4.63.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "start": "open http://localhost:8021/demo/ && static -p 8021",
    "prepublishOnly": "pnpm i && pnpm build && pnpm tsc && pnpm attw",
    "attw": "attw --pack . --profile esm-only",
    "tsc": "tsc",
    "build": "tsc -p tsconfig-prod.json && npm run rollup",
    "rollup": "rollup -c",
    "copy-simple-get-json": "cp -r node_modules/simple-get-json/dist/index-es.js demo/vendor/simple-get-json/dist/index-es.js",
    "copy-jhtml": "cp -Rf node_modules/jhtml/src demo/vendor/jhtml",
    "copy-jamilih": "cp node_modules/jamilih/dist/jml.mjs demo/vendor/jamilih/dist/jml.mjs",
    "copy-jsonpath-plus": "cp node_modules/jsonpath-plus/dist/index-browser-esm.js demo/vendor/jsonpath-plus/dist/index-browser-esm.js",
    "copy-fontoxpath": "cp node_modules/fontoxpath/dist/fontoxpath.esm.js demo/vendor/fontoxpath/dist/fontoxpath.esm.js",
    "copy-xspattern": "cp node_modules/xspattern/dist/xspattern.esm.js demo/vendor/xspattern/dist/xspattern.esm.js",
    "copy-prsc": "cp node_modules/prsc/dist/prsc.esm.js demo/vendor/prsc/dist/prsc.esm.js",
    "copy-whynot": "cp node_modules/whynot/dist/whynot.esm.js demo/vendor/whynot/dist/whynot.esm.js",
    "copy": "pnpm copy-simple-get-json && pnpm copy-jhtml && pnpm copy-jamilih && pnpm copy-jsonpath-plus && pnpm copy-fontoxpath && pnpm copy-xspattern && pnpm copy-prsc && pnpm copy-whynot",
    "lint": "eslint .",
    "mocha": "mocha",
    "test:browser": "open http://localhost:8020/test/browser/ && static -p 8020",
    "test": "c8 npm run mocha"
  },
  "bugs": "https://github.com/brettz9/jtlt/issues",
  "description": "Uses an approach similar to [XSLT](https://www.w3.org/Style/XSL/) for declarative, linear declaration of templates, but with JSON or JavaScript object data sources. As with XSLT, can be transformed into different formats (e.g., HTML strings, JSON, DOM objects, etc.).",
  "keywords": [
    "xsl",
    "xslt",
    "json",
    "javascript"
  ]
}
